# SQLite 数据库文件位置（相对 prisma/schema.prisma）
DATABASE_URL="file:./dev.db"

# 用于签发/校验 session JWT 的秘密，至少 32 字节，请用 `openssl rand -hex 32` 生成
SESSION_SECRET="replace-with-a-random-32-byte-hex-string"

# 种子管理员口令。除 NODE_ENV=development 外，执行 `prisma db seed` 时必须设置
SEED_ADMIN_PASSWORD="替换为强随机口令"

# 可信反向代理层数。默认 0：不信任 x-forwarded-for，所有请求共用一个限流桶。
# 部署在 Nginx/Vercel 等代理后时按实际层数设置（常见为 1）。
# TRUSTED_PROXY_HOPS="1"
